{
  "name": "atlas",
  "version": "1.0.0",
  "description": "atlas",
  "main": "index.js",
  "scripts": {
    "install-backend": "cd BACKEND && npm install",
    "install-frontend": "cd FRONTEND && npm install",
    "start-backend": "cd BACKEND && npm run start",
    "start-frontend": "cd FRONTEND && npm run dev",
    "start": "npm run start-backend && npm run start-frontend",
    "install": "npm run install-backend && npm run install-frontend",
    "sonar:up": "docker compose --profile tools up -d sonarqube",
    "sonar:scan": "docker compose --profile tools run --rm sonar-scanner",
    "sonar:down": "docker compose --profile tools down",
    "validate:agents": "node scripts/validate-agents.js"
  }
}
